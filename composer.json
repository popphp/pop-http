{
    "name": "popphp/pop-http",
    "description": "Pop Http Component for Pop PHP Framework",
    "keywords": [
        "http",
        "http client",
        "http request",
        "http response",
        "curl",
        "streams",
        "file uploads",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-http",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-filter": "^4.1.0-beta.2",
        "popphp/pop-mime": "^3.0.0-beta.2",
        "popphp/pop-utils": "^3.0.0-beta.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "suggest": {
        "ext-json": "For JSON data",
        "ext-simplexml": "For XML data",
        "ext-zlib": "For compression",
        "ext-mbstring": "For multi-byte strings"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Http\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "6.0.x-dev"
        }
    }
}
